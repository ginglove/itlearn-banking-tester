# Runtime Database Connection (Pooled for Neon or standard PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/neobank_ekyc

# Migration Database Connection (Unpooled)
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/neobank_ekyc

# Vercel Blob token for client uploads
BLOB_READ_WRITE_TOKEN=

# JWT session secret (>= 32 chars)
SESSION_SECRET=a_very_secure_random_session_secret_32_chars_minimum

# Trainer PIN for accessing /trainer
TRAINER_PIN=123456

# Readonly DB user password for learner SQL sandbox
READONLY_DB_PASSWORD=readonly_strong_password_hex_24_chars_min

# Default profile: training | reference
DEFAULT_PROFILE=training

# Default simulated business date (YYYY-MM-DD)
DEFAULT_TODAY=2026-11-23
